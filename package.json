{
  "name": "agri-fault-diagnosis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/dev.ts",
    "build": "sh scripts/build.sh",
    "build:client": "tsc -b tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.app.json --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.eslintcache --report-unused-disable-directives"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "0.577.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "react-error-boundary": "^6.1.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^9",
    "eslint": "^9",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.4",
    "tsx": "^4",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vite": "^7"
  }
}
